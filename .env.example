# Copy to .env next to docker-compose.server.yml. Never commit the real .env.

# Name your devices see for this server.
MEMEBOORU_NAME=memebooru-server

# From @BotFather. Leave empty to run sync only.
TELEGRAM_BOT_TOKEN=

# Your Telegram user id(s), comma-separated. Don't know it? Start the bot and message it — it replies with your id.
TELEGRAM_ALLOWED_USERS=

# Optional: a private channel (bot = admin) where the bot uploads files to get reusable file_ids.
# Empty = uploads go to your own chat silently and are deleted immediately.
TELEGRAM_CACHE_CHAT=

# Time zone for the date on tweets the bot sends as pictures, e.g. Europe/Moscow.
TZ=UTC
